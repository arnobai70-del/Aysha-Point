{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AYESHA canonical signal",
  "type": "object",
  "required": ["schema_version", "signal_id", "strategy_version", "strategy_hash", "pair", "direction", "setup",
               "event_time_utc", "status", "score_points", "score_is_probability", "rule_trace", "safe_to_alert_for_entry"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "signal_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "strategy_version": {"type": "string"},
    "strategy_hash": {"type": "string"},
    "pair": {"type": "string"},
    "broker_symbol": {"type": ["string", "null"]},
    "direction": {"enum": ["BUY", "SELL"]},
    "setup": {"type": "string"},
    "timeframe": {"type": "string"},
    "event_time_utc": {"type": "string", "format": "date-time"},
    "session": {"type": "array", "items": {"enum": ["SYDNEY", "TOKYO", "LONDON", "NEW_YORK"]}},
    "status": {"enum": ["WATCH", "READY", "NOTIFIED", "NO_TRADE", "INVALIDATED", "EXPIRED", "MISSED", "CANCELED",
                        "USER_MARKED_PLACED", "USER_MARKED_CLOSED", "DATA_STALE",
                        "ENTRY_TOUCHED", "OBSERVED_TP", "OBSERVED_SL"]},
    "grade": {"enum": ["A_PLUS", "WATCH", "IGNORE"]},
    "entry": {"type": ["number", "null"]},
    "stop_loss": {"type": ["number", "null"]},
    "take_profits": {"type": "array", "items": {"type": "number"}},
    "broker_prices": {"type": ["object", "null"]},
    "safe_lot": {"type": ["number", "null"]},
    "risk_usd": {"type": ["number", "null"]},
    "net_rr": {"type": ["number", "null"]},
    "spread_pips": {"type": ["number", "null"]},
    "score_points": {"type": "integer", "minimum": 0, "maximum": 100},
    "score_breakdown": {"type": "object"},
    "score_is_probability": {"const": false},
    "news_verification": {"enum": ["CLEAR", "BLOCKED", "UNKNOWN"]},
    "chart_parity": {"enum": ["MATCHED", "PARTIAL", "UNVERIFIED", "MISMATCH"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "rule_trace": {"type": "array", "items": {"type": "string"}},
    "expires_at_utc": {"type": ["string", "null"]},
    "safe_to_alert_for_entry": {"type": "boolean"}
  }
}
