{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arnobai70-del/Aysha-Point/contracts/research/market-bar.schema.json",
  "title": "Normalised closed market bar (research.market_bar/1)",
  "description": "One closed BID bar of a frozen dataset, UTC. ASK prices are never invented: ask_close is set only when the provider returned it (OANDA price=BA); a CSV import knows the spread only. Event time (bar open/close) and observed time (when this PC received it) are kept apart.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "symbol",
    "timeframe",
    "bar_open_utc",
    "bar_close_utc",
    "bid_open",
    "bid_high",
    "bid_low",
    "bid_close",
    "ask_close",
    "spread",
    "spread_basis",
    "volume",
    "is_closed",
    "observed_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "research.market_bar/1"
    },
    "provider": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{2,40}$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z]{6}$"
    },
    "timeframe": {
      "enum": [
        "M5",
        "M15"
      ]
    },
    "bar_open_utc": {
      "type": "string",
      "format": "utc-date-time"
    },
    "bar_close_utc": {
      "type": "string",
      "format": "utc-date-time"
    },
    "bid_open": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bid_high": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bid_low": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bid_close": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ask_close": {
      "type": [
        "number",
        "null"
      ]
    },
    "spread": {
      "type": [
        "number",
        "null"
      ],
      "description": "price units at bar close (ask - bid); null if unknown"
    },
    "spread_basis": {
      "enum": [
        "ASK_CLOSE_MINUS_BID_CLOSE",
        "CSV_WHOLE_POINTS",
        "UNKNOWN"
      ]
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "description": "tick volume for OTC forex"
    },
    "is_closed": {
      "const": true
    },
    "observed_at_utc": {
      "type": "string",
      "format": "utc-date-time"
    }
  }
}
