{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arnobai70-del/Aysha-Point/contracts/research/dataset-manifest.schema.json",
  "title": "Frozen dataset manifest (research.dataset_manifest/1)",
  "description": "Identity and provenance of one immutable market-data snapshot. dataset_id is derived from the normalised content, so the same data always has the same id and revised provider data always gets a new one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "source",
    "symbols",
    "timeframes",
    "range_utc",
    "downloaded_at_utc",
    "observed_at_basis",
    "partitions",
    "raw_sha256",
    "normalized_sha256",
    "quality_report_sha256",
    "quality_state",
    "license_notes",
    "limitations",
    "code"
  ],
  "properties": {
    "schema_version": {
      "const": "research.dataset_manifest/1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^ds_[0-9a-f]{16}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "adapter",
        "environment"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{6}$"
      }
    },
    "timeframes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "M5",
          "M15"
        ]
      }
    },
    "range_utc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "format": "utc-date-time"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "utc-date-time"
        }
      }
    },
    "downloaded_at_utc": {
      "type": "string",
      "format": "utc-date-time"
    },
    "observed_at_basis": {
      "enum": [
        "PROVIDER_RESPONSE_TIME",
        "IMPORT_TIME"
      ]
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "timeframe",
          "rows",
          "start_utc",
          "end_utc",
          "raw_sha256",
          "normalized_sha256",
          "quality_report_sha256",
          "quality_state"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z]{6}$"
          },
          "timeframe": {
            "enum": [
              "M5",
              "M15"
            ]
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          },
          "start_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "utc-date-time"
          },
          "end_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "utc-date-time"
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "normalized_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "quality_report_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "quality_state": {
            "enum": [
              "PASS",
              "DEGRADED",
              "REJECTED"
            ]
          }
        }
      }
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quality_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quality_state": {
      "enum": [
        "PASS",
        "DEGRADED",
        "REJECTED"
      ]
    },
    "license_notes": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "desktop_version"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "desktop_version": {
          "type": "string"
        }
      }
    }
  }
}
