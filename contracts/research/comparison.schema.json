{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arnobai70-del/Aysha-Point/contracts/research/comparison.schema.json",
  "title": "Strategy Lab comparison (research.comparison/1)",
  "description": "Side-by-side results of research strategies run on the same frozen dataset, symbols, split plan, cost models and account scenarios. Research only: never a trade signal, never a live candidate. A strategy that looks better in hindsight is not promoted by anything in this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "source_type",
    "executable",
    "dataset_id",
    "symbols",
    "split_plan_id",
    "cost_model_id",
    "account_scenario_id",
    "runs",
    "rows",
    "differences_vs_baseline",
    "ranking",
    "benchmark_parity",
    "limitations",
    "warnings",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "research.comparison/1"
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^cmp_[0-9a-f]{16}$"
    },
    "source_type": {
      "const": "RESEARCH"
    },
    "executable": {
      "const": false
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^ds_[0-9a-f]{16}$"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{6}$"
      }
    },
    "split_plan_id": {
      "type": "string",
      "pattern": "^sp_[0-9a-f]{16}$"
    },
    "cost_model_id": {
      "type": "string"
    },
    "account_scenario_id": {
      "type": "string"
    },
    "news_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ns_... snapshot, or NONE:NEWS_NOT_MODELLED (v1.1.0)"
    },
    "news_mode": {
      "enum": [
        "none",
        "legacy",
        "upgraded"
      ]
    },
    "regime_detector": {
      "type": [
        "string",
        "null"
      ],
      "description": "detector id@version#code hash (v1.1.0)"
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "strategy_id",
          "strategy_version",
          "strategy_hash",
          "kind",
          "result_sha256"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^run_[0-9a-f]{16}$"
          },
          "strategy_id": {
            "type": "string"
          },
          "strategy_version": {
            "type": "string"
          },
          "strategy_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          },
          "kind": {
            "enum": [
              "BASELINE",
              "CONTROL",
              "EXPERIMENTAL"
            ]
          },
          "result_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "differences_vs_baseline": {
      "type": "object"
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "order",
        "note"
      ],
      "properties": {
        "state": {
          "enum": [
            "NO_RANKING",
            "IN_SAMPLE_ORDER_ONLY"
          ]
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "benchmark_parity": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "utc-date-time"
    },
    "comparison_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
